    "Letras necesita el micrófono para reconocer la música que suena. Puedes activarlo en Ajustes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras needs the microphone to recognize the music that's playing. You can turn it on in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras a besoin du micro pour reconnaître la musique en cours. Vous pouvez l'activer dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras benötigt das Mikrofon, um die laufende Musik zu erkennen. Du kannst es in den Einstellungen aktivieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras ha bisogno del microfono per riconoscere la musica in riproduzione. Puoi attivarlo in Impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Letras precisa do microfone para reconhecer a música que está a tocar. Pode ativá-lo nas Definições."
          }
        }
      }
    },
