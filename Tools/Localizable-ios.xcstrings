{
  "sourceLanguage": "es",
  "strings": {
    "Abre la app cerca de la música: Letras reconoce la canción que suena y muestra su letra sincronizada con ella.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app near the music: Letras recognizes the song that's playing and shows its lyrics in sync with it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'app près de la musique : Letras reconnaît la chanson en cours et affiche ses paroles synchronisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App in der Nähe der Musik: Letras erkennt den laufenden Song und zeigt den Songtext synchron dazu an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app vicino alla musica: Letras riconosce la canzone in riproduzione e ne mostra il testo sincronizzato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a app perto da música: a Letras reconhece a canção que está a tocar e mostra a letra sincronizada com ela."
          }
        }
      }
    },
