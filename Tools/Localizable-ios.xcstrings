    "No reconozco lo que suena. Acerca el móvil a la música.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't recognize what's playing. Bring the phone closer to the music."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de reconnaître ce qui joue. Rapprochez le téléphone de la musique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was gerade läuft, wird nicht erkannt. Halte das iPhone näher an die Musik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riconosco ciò che suona. Avvicina il telefono alla musica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não reconheço o que está a tocar. Aproxime o telemóvel da música."
          }
        }
      }
    },
    "No se ha podido descargar la letra.": {
